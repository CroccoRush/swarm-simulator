root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
indent_style = space
indent_size = 4
max_line_length = 80

[{*.go,Makefile,go.mod,go.sum}]
indent_style = tab

[{*.yml,*.yaml,.prettierrc}]
indent_size = 2

[*.json]
indent_size = 2

[*.md]
indent_size = 2
